# Pick one provider. Any OpenAI-compatible endpoint works: openai, groq, openrouter, ollama (or a custom LLM_BASE_URL).
LLM_PROVIDER=openai
OPENAI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# LLM_BASE_URL=            # optional override for a custom OpenAI-compatible endpoint

# Optional per-role model overrides (defaults depend on provider; see scheduler/llm.py)
# Groq free tier is ~8k tokens/min per model: spread roles across models, e.g.
# AGENT_MODEL=openai/gpt-oss-120b  SIMULATOR_MODEL=openai/gpt-oss-20b  JUDGE_MODEL=qwen/qwen3.8-27b
# AGENT_MODEL=gpt-4.1-mini
# SIMULATOR_MODEL=gpt-4.1-mini
# JUDGE_MODEL=gpt-4.1
# REFLECTOR_MODEL=gpt-4.1
